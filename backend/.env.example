# Sao chép thành .env rồi sửa nếu cần. Mọi giá trị đều có mặc định.
# PostgreSQL (mặc định; tạo bằng scripts/setup_postgres.sql):
# DATABASE_URL=postgresql+psycopg://pitchpoint:pitchpoint@localhost:5432/pitchpoint
# Database cho pytest (bị xóa sạch mỗi lần chạy test):
# TEST_DATABASE_URL=postgresql+psycopg://pitchpoint:pitchpoint@localhost:5432/pitchpoint_test
# Chạy thử nhanh không cần PostgreSQL (chỉ 1 tiến trình, không dùng cho nhiều người):
# DATABASE_URL=sqlite:///./pitchpoint.db
# Số dư thử nghiệm tặng tài khoản mới (BR-32):
# INITIAL_BALANCE_VND=2000000
# Đặt false nếu chỉ cần API, không phục vụ giao diện:
# SERVE_FRONTEND=true
